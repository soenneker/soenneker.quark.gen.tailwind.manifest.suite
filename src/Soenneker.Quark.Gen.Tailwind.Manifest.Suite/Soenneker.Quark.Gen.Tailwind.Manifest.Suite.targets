<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="TailwindManifestSuiteGeneratorBuild_Imported" BeforeTargets="Build">
        <Message Importance="high" Text="Soenneker.Quark.Gen.Tailwind.Manifest.Suite targets imported from: $(MSBuildThisFileFullPath)" />
    </Target>

    <PropertyGroup>
        <!-- Select the SDK host rather than the application's RuntimeIdentifier (for example browser-wasm). -->
        <TailwindManifestSuiteToolRuntimeIdentifier Condition="'$(TailwindManifestSuiteToolRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</TailwindManifestSuiteToolRuntimeIdentifier>
        <_TailwindManifestSuiteExecutableName>Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks</_TailwindManifestSuiteExecutableName>
        <_TailwindManifestSuiteExecutableName Condition="$([System.String]::Copy('$(TailwindManifestSuiteToolRuntimeIdentifier)').StartsWith('win-'))">$(_TailwindManifestSuiteExecutableName).exe</_TailwindManifestSuiteExecutableName>
        <_TailwindManifestSuiteNativePackagePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/native/$(TailwindManifestSuiteToolRuntimeIdentifier)/$(_TailwindManifestSuiteExecutableName)'))</_TailwindManifestSuiteNativePackagePath>
        <_TailwindManifestSuiteNativeProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native/$(TailwindManifestSuiteToolRuntimeIdentifier)/$(_TailwindManifestSuiteExecutableName)'))</_TailwindManifestSuiteNativeProjectPath>
        <TailwindManifestSuiteBuildTasksExecutablePath Condition="'$(TailwindManifestSuiteBuildTasksExecutablePath)' == '' and Exists('$(_TailwindManifestSuiteNativePackagePath)')">$(_TailwindManifestSuiteNativePackagePath)</TailwindManifestSuiteBuildTasksExecutablePath>
        <TailwindManifestSuiteBuildTasksExecutablePath Condition="'$(TailwindManifestSuiteBuildTasksExecutablePath)' == ''">$(_TailwindManifestSuiteNativeProjectPath)</TailwindManifestSuiteBuildTasksExecutablePath>

        <TailwindManifestSuiteGeneratorBuildEnabled Condition="'$(TailwindManifestSuiteGeneratorBuildEnabled)'==''">true</TailwindManifestSuiteGeneratorBuildEnabled>
        <_TailwindManifestSuiteProjectDir>$([System.IO.Path]::GetDirectoryName('$(ProjectDir)x'))</_TailwindManifestSuiteProjectDir>
        <_TailwindManifestSuiteProjectDir Condition="'$(_TailwindManifestSuiteProjectDir)' == ''">$(MSBuildProjectDirectory)</_TailwindManifestSuiteProjectDir>
        <TailwindManifestSuiteOutput Condition="'$(TailwindManifestSuiteOutput)' == ''">$([System.IO.Path]::Combine('$(_TailwindManifestSuiteProjectDir)', 'tailwind', 'quark-suite-tailwind-manifest.txt'))</TailwindManifestSuiteOutput>
        <_TailwindManifestSuiteOutputArg Condition="'$(TailwindManifestSuiteOutput)' != ''"> --manifestOutput &quot;$(TailwindManifestSuiteOutput)&quot;</_TailwindManifestSuiteOutputArg>
    </PropertyGroup>

    <Target Name="RunTailwindManifestSuiteGeneratorBuildTasks"
            BeforeTargets="Build"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(TailwindManifestSuiteGeneratorBuildEnabled)'=='true'">

        <Message Importance="high" Text="Running Soenneker.Quark.Gen.Tailwind.Manifest.Suite BuildTasks: projectDir=$(_TailwindManifestSuiteProjectDir) output=$(TailwindManifestSuiteOutput)" />
        <Error Condition="'$(_TailwindManifestSuiteProjectDir)' == ''"
               Text="Soenneker.Quark.Gen.Tailwind.Manifest.Suite: project directory could not be resolved (ProjectDir and MSBuildProjectDirectory are empty)." />
        <Error Condition="'$(TailwindManifestSuiteBuildTasksExecutablePath)'==''"
               Text="TailwindManifestSuiteBuildTasksExecutablePath was not resolved. MSBuildThisFileDirectory=$(MSBuildThisFileDirectory)" />
        <Error Condition="!Exists('$(TailwindManifestSuiteBuildTasksExecutablePath)')"
               Text="Tailwind.Manifest.Suite native BuildTasks executable not found at '$(TailwindManifestSuiteBuildTasksExecutablePath)'." />

        <!-- NuGet extraction does not preserve Unix execute permissions. -->
        <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(TailwindManifestSuiteBuildTasksExecutablePath)&quot;" />
        <Exec WorkingDirectory="$(_TailwindManifestSuiteProjectDir)"
              IgnoreExitCode="false"
              ConsoleToMSBuild="true"
              StandardOutputImportance="high"
              StandardErrorImportance="high"
              Command='&quot;$(TailwindManifestSuiteBuildTasksExecutablePath)&quot; --projectDir &quot;$(_TailwindManifestSuiteProjectDir)&quot;$(_TailwindManifestSuiteOutputArg)' />
    </Target>
</Project>
