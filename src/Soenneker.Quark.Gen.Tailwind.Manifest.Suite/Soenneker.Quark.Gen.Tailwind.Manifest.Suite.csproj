<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A generator that builds a manifest of tailwind usage in the Soenneker.Quark.Suite project</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Quark.Gen.Tailwind.Manifest.Suite</AssemblyName>
        <PackageId>Soenneker.Quark.Gen.Tailwind.Manifest.Suite</PackageId>
        <PackageTags>quark gen tailwind manifest suite source generator tailwindmanifestsuitegenerator externalgenerator csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.quark.gen.tailwind.manifest.suite</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.quark.gen.tailwind.manifest.suite</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Quark.Gen.Tailwind.Manifest.Suite.targets" Pack="true" PackagePath="build\" />
        <None Include="Soenneker.Quark.Gen.Tailwind.Manifest.Suite.targets" Pack="true" PackagePath="buildTransitive\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
    <PropertyGroup>
        <TailwindManifestSuiteNativeRuntimeIdentifier Condition="'$(TailwindManifestSuiteNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</TailwindManifestSuiteNativeRuntimeIdentifier>
        <TailwindManifestSuiteNativeArtifactsDir Condition="'$(TailwindManifestSuiteNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</TailwindManifestSuiteNativeArtifactsDir>
        <_TailwindManifestSuiteNativeExecutable>Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks</_TailwindManifestSuiteNativeExecutable>
        <_TailwindManifestSuiteNativeExecutable Condition="$([System.String]::Copy('$(TailwindManifestSuiteNativeRuntimeIdentifier)').StartsWith('win-'))">$(_TailwindManifestSuiteNativeExecutable).exe</_TailwindManifestSuiteNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(TailwindManifestSuiteUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(TailwindManifestSuiteNativeSource);../Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks/obj/project.assets.json"
            Outputs="$(TailwindManifestSuiteNativeArtifactsDir)/$(TailwindManifestSuiteNativeRuntimeIdentifier)/$(_TailwindManifestSuiteNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks/Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks.csproj&quot; --configuration Release --runtime $(TailwindManifestSuiteNativeRuntimeIdentifier) --output &quot;$(TailwindManifestSuiteNativeArtifactsDir)/$(TailwindManifestSuiteNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <TailwindManifestSuiteNativeSource Include="../Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks/**/*.cs;../Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks/bin/**;../Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_TailwindManifestSuiteRequiredRuntime Include="win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64" Condition="'$(TailwindManifestSuiteUsePrebuiltNativeTools)' == 'true'" />
            <_TailwindManifestSuiteNativeFile Include="$(TailwindManifestSuiteNativeArtifactsDir)/**/*"
                                Exclude="$(TailwindManifestSuiteNativeArtifactsDir)/**/*.pdb;$(TailwindManifestSuiteNativeArtifactsDir)/**/*.dbg;$(TailwindManifestSuiteNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_TailwindManifestSuiteNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_TailwindManifestSuiteRequiredRuntime)' != '' and !Exists('$(TailwindManifestSuiteNativeArtifactsDir)/%(_TailwindManifestSuiteRequiredRuntime.Identity)/Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks') and !Exists('$(TailwindManifestSuiteNativeArtifactsDir)/%(_TailwindManifestSuiteRequiredRuntime.Identity)/Soenneker.Quark.Gen.Tailwind.Manifest.Suite.BuildTasks.exe')"
               Text="Missing native tailwind.manifest.suite tool for %(_TailwindManifestSuiteRequiredRuntime.Identity)." />
        <Error Condition="'@(_TailwindManifestSuiteNativeFile)' == ''" Text="Native tailwind.manifest.suite tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
